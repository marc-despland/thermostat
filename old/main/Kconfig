menu "Thermostat Gateway Configuration"

    config EXAMPLE_CONNECT_WIFI
        bool "Connect to WiFi"
        default n
        help
            Set this to true to connect the gateway to WiFi for remote management.

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        depends on EXAMPLE_CONNECT_WIFI
        default "myssid"
        help
            SSID of the router.

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        depends on EXAMPLE_CONNECT_WIFI
        default "mypassword"
        help
            WiFi password (WPA or WPA2).

    config THERMOSTAT_ENABLE_CLI
        bool "Enable Console CLI Commands"
        default y
        help
            Enable CLI commands for device pairing and management:
            - permit_join <duration>
            - list_devices
            - remove_device <index>

    config THERMOSTAT_DEFAULT_CHANNEL
        int "Zigbee Channel (15-25)"
        default 25
        range 15 25
        help
            Primary Zigbee channel (15, 20, 25 recommended).
            KETOTEK typically uses 15, 20, or 25.

    config THERMOSTAT_MAX_CHILDREN
        int "Maximum Child Devices"
        default 10
        range 1 32
        help
            Maximum number of child devices that can be connected.

endmenu
